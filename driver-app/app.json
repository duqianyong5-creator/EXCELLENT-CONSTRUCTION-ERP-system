{
  "expo": {
    "name": "ECT Technician",
    "slug": "truck-driver-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/log.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/log.png",
      "resizeMode": "contain",
      "backgroundColor": "#1677ff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.internal.truckdriver",
      "infoPlist": {
        "NSCameraUsageDescription": "完成任务时需要拍摄工作照片",
        "NSPhotoLibraryUsageDescription": "完成任务时需要选择工作照片"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/log.png",
        "backgroundColor": "#1677ff"
      },
      "package": "com.internal.truckdriver",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "完成任务时需要拍摄工作照片"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "truckdriver",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0da4519f-0ea6-48d5-861f-9131921cb4af"
      }
    },
    "owner": "qianyong000"
  }
}
