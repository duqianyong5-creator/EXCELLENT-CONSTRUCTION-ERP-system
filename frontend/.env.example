# Web Admin Console - development settings (optional)
#
# The dev server proxies /api, /uploads and /socket.io to the backend, so nothing is
# required here for local work. To run the local console against the live backend:
#   VITE_PROXY_TARGET=https://backend-production-ff66.up.railway.app npm run dev
#
# The production build uses .env.production (VITE_API_URL). Maps are Leaflet/OpenStreetMap;
# no map API key is needed.
# VITE_PROXY_TARGET=http://127.0.0.1:3000
