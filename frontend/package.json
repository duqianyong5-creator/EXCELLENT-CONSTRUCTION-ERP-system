{
  "name": "truck-dispatch-frontend",
  "version": "1.0.0",
  "description": "ECT ERP — Dispatch Management System",
  "author": "Excellent Construction Ltd",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.json",
    "electron:dev": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "check:locales": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@ant-design/plots": "^2.2.0",
    "@react-google-maps/api": "^2.19.3",
    "@reduxjs/toolkit": "^2.2.0",
    "@types/leaflet": "^1.9.21",
    "antd": "^5.14.0",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "i18next": "^23.10.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.0",
    "socket.io-client": "^4.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.3.3",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.ect.erp",
    "productName": "ECT ERP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-round.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ECT ERP",
      "uninstallDisplayName": "ECT ERP"
    }
  }
}
