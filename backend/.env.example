# Backend production environment example

# App
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-web-domain.example

# PostgreSQL / Supabase
# The backend reads these split DB_* variables. DATABASE_URL is not used by the app.
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_NAME=postgres

# Auth
# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=truck-uploads

# Optional maps
GOOGLE_MAPS_API_KEY=

# 车载 JT808 GPS 定位器网关（不设置 JT808_PORT 则不启动）
# Railway：Settings → Networking → TCP Proxy，把分配的 domain:port 配到设备的服务器地址
JT808_PORT=5023
# 设备上报时间所用时区（厂家协议默认北京时间 +8；设备发 0x1007 时区同步时以设备为准）
JT808_DEVICE_TZ_OFFSET_HOURS=8
